{
  "name": "zwip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:packages && tauri build --bundles app",
    "build:packages": "node scripts/build-packages.mjs",
    "check": "tsc --noEmit && npm run lint && npm run format:check && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "vitest run",
    "test:go": "node scripts/test-go.mjs",
    "test:e2e": "wdio run wdio.conf.mjs",
    "bench:workspace": "node scripts/bench-workspace.mjs",
    "build:e2e": "VITE_E2E=1 tauri build --debug --features e2e --config src-tauri/tauri.e2e.conf.json --no-bundle",
    "lint": "eslint src site/main.ts vite.site.config.ts packages/web/src packages/tools/src tests --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write . && cargo fmt --all"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.55.0",
    "markdown-it": "15.0.2",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "typescript": "5.9.3",
    "typescript-sdk": "npm:typescript@5.9.3",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "next": "16.4.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "webdriverio": "9.32.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "serialize-javascript": "7.1.2"
  }
}
