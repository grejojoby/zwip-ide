{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zwip",
  "version": "0.1.0",
  "identifier": "dev.zwip.ide",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web && node scripts/application-notices.mjs",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Zwip",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "../dist/application-notices/": "notices/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.5", "signingIdentity": "-" }
  }
}
