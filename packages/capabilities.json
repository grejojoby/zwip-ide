[
  {
    "language": "go",
    "documentExtensions": ["go"],
    "configGlobs": ["go.mod"],
    "configurationGlobs": ["go.mod", "go.sum", "go.work", "go.work.sum"]
  },
  {
    "language": "web",
    "documentExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "cjs",
      "mts",
      "cts",
      "html",
      "htm",
      "css"
    ],
    "configGlobs": ["tsconfig*.json", "jsconfig*.json"],
    "configurationGlobs": [
      "tsconfig*.json",
      "jsconfig*.json",
      "package.json",
      "package-lock.json",
      "next.config.*"
    ]
  },
  {
    "language": "php",
    "documentExtensions": ["php", "phtml", "php8"],
    "configGlobs": ["composer.json", "*.php", "*.phtml", "*.php8"],
    "configurationGlobs": ["composer.json", "composer.lock"]
  }
]
